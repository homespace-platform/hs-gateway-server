# Production environment — copy to .env and fill in values
# In launch.json set: "envFile": "${workspaceFolder}/hs-gateway-server/.env"

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

EUREKA_CLIENT_SERVICE_URL=http://eureka-host:8761/eureka

JWT_JWK_SET_URI=https://auth.example.com/realms/homespace-platform/protocol/openid-connect/certs
JWT_ISSUER_URI=https://auth.example.com/realms/homespace-platform
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

REDIS_HOST=redis-host
REDIS_PORT=6379
REDIS_PASSWORD=

GATEWAY_RATE_LIMITER_REPLENISH_RATE=10
GATEWAY_RATE_LIMITER_BURST_CAPACITY=20
GATEWAY_RATE_LIMITER_REQUESTED_TOKENS=1

LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_RATELIMIT=WARN
