# Development environment — copy to .env.dev and fill in values
# In launch.json set: "envFile": "${workspaceFolder}/hs-gateway-server/.env.dev"

SPRING_PROFILES_ACTIVE=dev

EUREKA_CLIENT_SERVICE_URL=http://localhost:8761/eureka

# Must match hs-ai-service/.env; never commit the real value.
GATEWAY_INTERNAL_SECRET=

JWT_JWK_SET_URI=http://localhost:9000/realms/homespace-platform/protocol/openid-connect/certs
JWT_ISSUER_URI=http://localhost:9000/realms/homespace-platform
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=homespace123

GATEWAY_RATE_LIMITER_REPLENISH_RATE=50
GATEWAY_RATE_LIMITER_BURST_CAPACITY=100
GATEWAY_RATE_LIMITER_REQUESTED_TOKENS=1

LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_RATELIMIT=DEBUG
